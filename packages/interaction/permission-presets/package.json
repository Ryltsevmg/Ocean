{
  "name": "@ocean/ocean-permission-presets",
  "description": "User-facing permission presets (ctx.permissionPresets) for the Ocean: one product-level Permissions select bundling the sandbox-mode and approval-policy knobs, written through to their own session events",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/interaction/permission-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-shell": "workspace:*",
    "@ocean/ocean-commands": "workspace:*",
    "@ocean/ocean-sandbox": "workspace:*",
    "@ocean/ocean-sandbox-policy": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-user-approval": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-shell": "workspace:*",
    "@ocean/ocean-commands": "workspace:*",
    "@ocean/ocean-sandbox": "workspace:*",
    "@ocean/ocean-sandbox-policy": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-user-approval": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-settings": "workspace:*",
    "@ocean/ocean-agent-loop-testkit": "workspace:*"
  }
}
