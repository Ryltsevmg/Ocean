{
  "name": "@ocean/ocean-user-approval",
  "description": "User-approval seam (ctx.approval) for the Ocean: one-shot permission decisions dispatched to composed answerers over the approval/request waterfall, fail-closed by default",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/interaction/user-approval"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-brand": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-scope": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-session-projection": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-brand": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-scope": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-session-projection": "workspace:*"
  }
}
