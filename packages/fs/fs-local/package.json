{
  "name": "@ocean/ocean-fs-local",
  "description": "Local-filesystem implementation of the Ocean filesystem seam (ctx.fs)",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ocean/ocean-fs": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "koffi": "3.1.1",
    "@deepseek-ai/schemastery": "workspace:~",
    "@ocean/ocean-fs-patch": "workspace:*"
  },
  "devDependencies": {
    "@ocean/ocean-fs": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
