{
  "name": "@ocean/ocean-schedule",
  "description": "Host-wide durable reminders with shared management and delivery to existing or new Sessions",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-api-session-controller": "workspace:*",
    "@ocean/ocean-brand": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-persistence": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-storage-domain": "workspace:*",
    "@ocean/ocean-subagent": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-util-time": "workspace:*",
    "@ocean/ocean-workspace": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "@js-temporal/polyfill": "0.5.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-agent-loop": "workspace:*",
    "@ocean/ocean-agent-loop-testkit": "workspace:*",
    "@ocean/ocean-api-session-controller": "workspace:*",
    "@ocean/ocean-brand": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-persistence": "workspace:*",
    "@ocean/ocean-session-persistence-jsonl": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-session-title": "workspace:*",
    "@ocean/ocean-storage": "workspace:*",
    "@ocean/ocean-storage-domain": "workspace:*",
    "@ocean/ocean-storage-json": "workspace:*",
    "@ocean/ocean-subagent": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-tool-executor-native": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-util-time": "workspace:*",
    "@ocean/ocean-workspace": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-goal": "workspace:*",
    "@ocean/ocean-goal-round-driver": "workspace:*"
  }
