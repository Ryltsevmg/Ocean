{
  "name": "@ocean/ocean-tool-lsp",
  "description": "Model-facing lsp tool over the Ocean LSP capability seam (ctx.lsp) \u2014 one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-lsp": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-timeout": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-working-directory": "workspace:*"
  },
  "dependencies": {
    "@ocean/ocean-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-fs-local": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-lsp": "workspace:*",
    "@ocean/ocean-lsp-stdio": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-subprocess-local": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-timeout": "workspace:*",
    "@ocean/ocean-tool-call-timeout-policy": "workspace:*",
    "@ocean/ocean-tool-executor-native": "workspace:*",
    "@ocean/ocean-tool-testkit": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-working-directory": "workspace:*",
    "@ocean/ocean-agent-loop-testkit": "workspace:*"
  }
}
