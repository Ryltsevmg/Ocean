{
  "name": "@ocean/ocean-token-meter",
  "description": "Replay-aware token measurement service (ctx.tokenMeter) for the Ocean",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/llm/token-meter"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./estimate": {
      "types": "./lib/types/estimate.d.ts",
      "default": "./lib/types/estimate.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-compaction": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-llm-retry": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-compaction-image-offload": "workspace:*"
  },
  "dependencies": {
    "@ocean/ocean-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-compaction": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-llm-retry": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-compaction-image-offload": "workspace:*"
  }
}
