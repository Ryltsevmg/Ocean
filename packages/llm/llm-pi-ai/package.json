{
  "name": "@ocean/ocean-llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the Ocean LLM seam (design-verification twin of dsh-llm-deepseek)",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-attachment": "workspace:*",
    "@ocean/ocean-authorization": "workspace:*",
    "@ocean/ocean-credentials": "workspace:*",
    "@ocean/ocean-fs": "workspace:*",
    "@ocean/ocean-launch-environment": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-timeout": "workspace:*"
  },
  "dependencies": {
    "@ocean/ocean-brand": "workspace:*",
    "@ocean/ocean-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-agent-loop-testkit": "workspace:*",
    "@ocean/ocean-attachment": "workspace:*",
    "@ocean/ocean-authorization": "workspace:*",
    "@ocean/ocean-credentials": "workspace:*",
    "@ocean/ocean-fs": "workspace:*",
    "@ocean/ocean-http-proxy": "workspace:*",
    "@ocean/ocean-launch-environment": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-llm-deepseek": "workspace:*",
    "@ocean/ocean-llm-deepseek-api-key": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-settings": "workspace:*",
    "@ocean/ocean-timeout": "workspace:*",
    "@ocean/ocean-tool-testkit": "workspace:*",
    "@ocean/ocean-tools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    }
  }
}
