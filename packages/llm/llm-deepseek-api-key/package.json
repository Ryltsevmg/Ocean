{
  "name": "@ocean/ocean-llm-deepseek-api-key",
  "description": "DeepSeek api-key provider authentication and discovery",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
