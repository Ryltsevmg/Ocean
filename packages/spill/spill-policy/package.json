    "@ocean/ocean-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-attachment": "workspace:*",
    "@ocean/ocean-fs": "workspace:*",
    "@ocean/ocean-token-meter": "workspace:*"
  },
  "dependencies": {
