{
  "name": "@ocean/ocean-plugin-market",
  "version": "1.0.0",
  "description": "Curated plugin catalog for Ocean",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "ocean": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@ocean/ocean-api-remotes",
        "@ocean/ocean-client-locale",
        "@ocean/ocean-client-ui-slots",
        "@ocean/ocean-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "ocean": "1.0.0"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/extensions/plugin-market"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-api-remotes": "workspace:*",
    "@ocean/ocean-client-locale": "workspace:*",
    "@ocean/ocean-client-ui-plugin-manager": "workspace:*",
    "@ocean/ocean-client-ui-slots": "workspace:*",
    "react": "^18.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
