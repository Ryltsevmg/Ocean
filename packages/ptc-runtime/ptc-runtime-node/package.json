{
  "name": "@ocean/ocean-ptc-runtime-node",
  "description": "Node PTC execution with async function, REPL, scoped REPL and VM Script evaluators and optional retained state",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/ptc-runtime/ptc-runtime-node"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./configuration": {
      "types": "./lib/types/configuration.d.ts",
      "default": "./lib/configuration.js"
    },
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/configuration.js",
    "lib/process.js",
    "lib/persistent-process.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-ptc-runtime": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-timeout": "workspace:*",
    "@ocean/ocean-fs": "workspace:*",
    "@ocean/ocean-subprocess": "workspace:*",
    "@ocean/ocean-sandbox": "workspace:*",
    "@ocean/ocean-sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@ocean/ocean-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "birpc": "4.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-ptc-runtime": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-timeout": "workspace:*",
    "@ocean/ocean-fs": "workspace:*",
    "@ocean/ocean-subprocess": "workspace:*",
    "@ocean/ocean-sandbox": "workspace:*",
    "@ocean/ocean-sandbox-policy": "workspace:*",
    "@ocean/ocean-fs-local": "workspace:*",
    "@ocean/ocean-subprocess-local": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-sandbox-local": "workspace:*",
    "@ocean/ocean-attachment": "workspace:*"
  }
}
