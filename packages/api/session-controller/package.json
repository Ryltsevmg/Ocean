    "@ocean/ocean-client-file-upload": "workspace:*",
    "@ocean/ocean-commands": "workspace:*",
    "@ocean/ocean-credentials": "workspace:*",
    "@ocean/ocean-file-reference": "workspace:*",
    "@ocean/ocean-fs": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-native-command": "workspace:*",
    "@ocean/ocean-scope": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-persistence": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-session-projection-cache": "workspace:*",
