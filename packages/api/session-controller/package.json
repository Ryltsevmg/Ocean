    "@ocean/ocean-session-title": "workspace:*",
    "@ocean/ocean-settings": "workspace:*",
    "@ocean/ocean-skill": "workspace:*",
    "@ocean/ocean-subagent": "workspace:*",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-typert-registry": "workspace:*",
    "@ocean/ocean-util-time": "workspace:*",
    "@ocean/ocean-util-values": "workspace:*",
    "@ocean/ocean-util-workspace-path": "workspace:*",
    "@ocean/ocean-workspace": "workspace:*",
    "@ocean/ocean-working-directory": "workspace:*"
  },
