{
  "name": "@ocean/ocean-api-workspace-controller",
  "description": "Workspace Remote commands and reconnect-safe state transport",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/api/workspace-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./default-workspace": {
      "types": "./lib/types/default-workspace.d.ts",
      "default": "./lib/types/default-workspace.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "external": [
        "@ocean/ocean-api-gateway/client"
      ],
      "inject": [
        "@ocean/ocean-api-gateway",
        "@ocean/ocean-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@ocean/ocean-deque": "workspace:*",
    "@ocean/ocean-native-command": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-api-gateway": "workspace:*",
    "@ocean/ocean-client-connection": "workspace:*",
    "@ocean/ocean-host-directory-picker": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-storage-domain": "workspace:*",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-workspace": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-api-gateway": "workspace:*",
    "@ocean/ocean-api-remote-access": "workspace:*",
    "@ocean/ocean-client-connection": "workspace:*",
    "@ocean/ocean-client-store": "workspace:*",
    "@ocean/ocean-client-test-runtime": "workspace:*",
    "@ocean/ocean-host-directory-picker": "workspace:*",
    "@ocean/ocean-remote-mock": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-storage-domain": "workspace:*",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-workspace": "workspace:*"
  }
}
