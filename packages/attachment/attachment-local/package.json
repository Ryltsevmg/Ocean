{
  "name": "@ocean/ocean-attachment-local",
  "description": "Private content-addressed DSH_HOME attachment storage",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/attachment/attachment-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ocean/ocean-attachment": "workspace:*",
    "@ocean/ocean-home-paths": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@ocean/ocean-lazy-require": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@ocean/ocean-attachment": "workspace:*",
    "@ocean/ocean-home-paths": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
