{
  "name": "@ocean/ocean-client-ui-sidebar-documentpreview",
  "description": "Extensible Sidebar previews for Office documents, spreadsheets, Markdown, code, images, PDF, HTML, and plain text",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/client/ui-sidebar-documentpreview"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@ocean/ocean-api-gateway",
        "@ocean/ocean-api-workspace-files",
        "@ocean/ocean-client-resources",
        "@ocean/ocean-client-ui-sidebar-right",
        "@ocean/ocean-client-ui-session",
        "@ocean/ocean-api-remotes",
        "@ocean/ocean-client-locale",
        "@ocean/ocean-client-ui-settings",
        "@ocean/ocean-client-ui-file-drag",
        "@ocean/ocean-client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-api-gateway": "workspace:*",
    "@ocean/ocean-api-remotes": "workspace:*",
    "@ocean/ocean-api-workspace-files": "workspace:*",
    "@ocean/ocean-client-connection": "workspace:*",
    "@ocean/ocean-client-locale": "workspace:*",
    "@ocean/ocean-client-resources": "workspace:*",
    "@ocean/ocean-client-store": "workspace:*",
    "@ocean/ocean-client-test-runtime": "workspace:*",
    "@ocean/ocean-client-ui-dockkit": "workspace:*",
    "@ocean/ocean-client-ui-primitives": "workspace:*",
    "@ocean/ocean-client-ui-renderer": "workspace:*",
    "@ocean/ocean-client-ui-session": "workspace:*",
    "@ocean/ocean-client-ui-settings": "workspace:*",
    "@ocean/ocean-client-ui-sidebar-files": "workspace:*",
    "@ocean/ocean-client-ui-sidebar-right": "workspace:*",
    "@ocean/ocean-client-ui-slots": "workspace:*",
    "@ocean/ocean-office-kit": "workspace:*",
    "@ocean/ocean-host-webserver": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-util-workspace-path": "workspace:*",
    "@fortune-sheet/core": "1.0.4",
    "@fortune-sheet/react": "1.0.4",
    "@testing-library/react": "^16.3.3",
    "@types/papaparse": "^5.3.16",
    "clsx": "^2.0.0",
    "dompurify": "^3.4.17",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "fflate": "^0.8.3",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.3.289",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.0",
    "@ocean/ocean-client-ui-file-drag": "workspace:*",
    "@ocean/ocean-client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  }
}
