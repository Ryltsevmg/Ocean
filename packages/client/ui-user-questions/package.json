{
  "name": "@ocean/ocean-client-ui-user-questions",
  "description": "Web ask_user_question composer takeover and plan-review presentation UI",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/client/ui-user-questions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@ocean/ocean-api-remotes",
        "@ocean/ocean-api-session-controller",
        "@ocean/ocean-client-locale",
        "@ocean/ocean-client-ui-conversation",
        "@ocean/ocean-client-ui-renderer",
        "@ocean/ocean-client-ui-session",
        "@ocean/ocean-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-api-remotes": "workspace:*",
    "@ocean/ocean-api-session-controller": "workspace:*",
    "@ocean/ocean-brand": "workspace:*",
    "@ocean/ocean-client-locale": "workspace:*",
    "@ocean/ocean-client-store": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-tool-executor-native": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-user-questions": "workspace:*",
    "@ocean/ocean-client-ui-primitives": "workspace:*",
    "@ocean/ocean-client-ui-slots": "workspace:*",
    "@ocean/ocean-client-ui-renderer": "workspace:*",
    "@ocean/ocean-client-ui-session": "workspace:*",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "react": "^18.2.0",
    "@ocean/ocean-client-ui-conversation": "workspace:*",
    "@ocean/ocean-client-connection": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "clsx": "^2.0.0",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-client-ui-chat": "workspace:*",
    "@ocean/ocean-client-ui-tool": "workspace:*",
    "@ocean/ocean-tool-executor-ptc": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ]
}
