{
  "name": "@ocean/ocean-client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@ocean/ocean-api-workspace-controller",
        "@ocean/ocean-client-connection",
        "@ocean/ocean-client-locale",
        "@ocean/ocean-client-ui-conversation",
        "@ocean/ocean-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ocean/ocean-spill-policy": "workspace:*",
    "@ocean/ocean-fs-patch": "workspace:*",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-tool-testkit": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-tool-executor-native": "workspace:*",
    "@ocean/ocean-tool-executor-ptc": "workspace:*",
    "@ocean/ocean-tool-jobs": "workspace:*",
    "@ocean/ocean-tool-session-query": "workspace:*",
    "@ocean/ocean-tool-terminal": "workspace:*",
    "@ocean/ocean-spill": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-api-remotes": "workspace:*",
    "@ocean/ocean-client-connection": "workspace:*",
    "@ocean/ocean-client-locale": "workspace:*",
    "@ocean/ocean-client-test-runtime": "workspace:*",
    "@ocean/ocean-client-ui-conversation": "workspace:*",
    "@ocean/ocean-client-ui-primitives": "workspace:*",
    "@ocean/ocean-client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@ocean/ocean-api-workspace-controller": "workspace:*",
    "@ocean/ocean-client-ui-chat": "workspace:*",
    "@ocean/ocean-client-ui-renderer": "workspace:*",
    "@ocean/ocean-client-ui-session": "workspace:*",
    "@ocean/ocean-util-values": "workspace:*",
    "@ocean/ocean-util-workspace-path": "workspace:*",
    "@ocean/ocean-attachment": "workspace:*",
    "clsx": "^2.0.0",
    "@ocean/ocean-ptc-runtime": "workspace:*",
    "@ocean/ocean-token-meter": "workspace:*",
    "@ocean/ocean-user-questions": "workspace:*",
    "@ocean/ocean-client-ui-context-menu": "workspace:*",
    "@ocean/ocean-api-session-controller": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ]
}
