{
  "name": "@ocean/ocean-agent-preset",
  "description": "Declare an Agent capability composition in Cordis YAML",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/preset/agent-preset"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "skills",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-agent-preset-registry": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-agent-preset-registry": "workspace:*",
    "@ocean/ocean-compaction-tool-result-pruner": "workspace:*",
    "@ocean/ocean-plugin-detail": "workspace:*",
    "@ocean/ocean-skill": "workspace:*",
    "@ocean/ocean-skill-filesystem": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.3.2"
  }
}
