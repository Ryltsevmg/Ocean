{
  "name": "@ocean/ocean-agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the Ocean",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/core/agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-scope": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-util-values": "workspace:*",
    "@ocean/ocean-workspace": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@ocean/ocean-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-scope": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-typert-registry": "workspace:*",
    "@ocean/ocean-util-values": "workspace:*",
    "@ocean/ocean-workspace": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@ocean/ocean-brand": "workspace:*",
    "zod": "4.6.6"
  }
}
