{
  "name": "@ocean/ocean-tool-executor-ptc",
  "description": "PTC program execution, tool bindings, and generated SDK prompts",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/core/tool-executor-ptc"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./run-code": {
      "types": "./lib/types/run-code.d.ts",
      "default": "./lib/run-code.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/run-code.js",
    "lib/_chunks/*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-ptc-runtime": "workspace:*",
    "@ocean/ocean-sandbox": "workspace:*",
    "@ocean/ocean-sandbox-policy": "workspace:*",
    "@ocean/ocean-scope": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-user-approval": "workspace:*",
    "@ocean/ocean-working-directory": "workspace:*"
  },
  "dependencies": {
    "@ocean/ocean-brand": "workspace:*",
    "@ocean/ocean-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-agent-loop-testkit": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-ptc-runtime": "workspace:*",
    "@ocean/ocean-sandbox": "workspace:*",
    "@ocean/ocean-sandbox-policy": "workspace:*",
    "@ocean/ocean-scope": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-tool-executor-native": "workspace:*",
    "@ocean/ocean-tool-testkit": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-user-approval": "workspace:*",
    "@ocean/ocean-working-directory": "workspace:*"
  }
}
