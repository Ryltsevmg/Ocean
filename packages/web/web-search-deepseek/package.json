{
  "name": "@ocean/ocean-web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the Ocean web capability seam (ctx.web)",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-credentials": "workspace:*",
    "@ocean/ocean-deepseek-account": "workspace:*",
    "@ocean/ocean-launch-environment": "workspace:*",
    "@ocean/ocean-llm-deepseek": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-web": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-credentials": "workspace:*",
    "@ocean/ocean-credentials-local": "workspace:*",
    "@ocean/ocean-deepseek-account": "workspace:*",
    "@ocean/ocean-launch-environment": "workspace:*",
    "@ocean/ocean-llm-deepseek": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-web": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ocean/ocean-deepseek-account": {
      "optional": true
    }
  }
}
