{
  "name": "@ocean/ocean-compaction",
  "description": "Abstract compaction service seam (ctx.compaction) for the Ocean",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/compaction/compaction"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./checkpoint": {
      "types": "./lib/types/checkpoint.d.ts",
      "default": "./lib/types/checkpoint.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ocean/ocean-brand": "workspace:*",
    "@ocean/ocean-commands": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ocean/ocean-brand": "workspace:*",
    "@ocean/ocean-commands": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
