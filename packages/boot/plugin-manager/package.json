{
  "name": "@ocean/ocean-plugin-manager",
  "description": "Current-profile plugin and bundle management shared by dsh CLI, Web and agent tools",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./tools/locale/*.json": "./locale/tools/*.json",
    "./locale/*.json": "./locale/*.json",
    "./diagnostic": {
      "types": "./lib/types/diagnostic.d.ts",
      "default": "./lib/types/diagnostic.js"
    }
  },
  "files": [
    "locale/*.json",
    "locale/tools/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@ocean/ocean-app-boot": "workspace:*",
    "@ocean/ocean-atomic-write": "workspace:*",
    "@ocean/ocean-official-bundles": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "execa": "^10.0.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.0",
    "zod": "4.6.6",
    "@ocean/ocean-util-values": "workspace:*",
    "@ocean/ocean-plugin-detail": "workspace:*",
    "@ocean/ocean-timeout": "workspace:*",
    "hosted-git-info": "^9.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-host-plugin-inventory": "workspace:*",
    "@ocean/ocean-subprocess": "workspace:*",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-hmr": "workspace:*",
    "@ocean/ocean-brand": "workspace:*",
    "@ocean/ocean-sandbox-policy": "workspace:*",
    "@ocean/ocean-sandbox": "workspace:*",
    "@ocean/ocean-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ocean/ocean-hmr": {
      "optional": true
    },
    "@ocean/ocean-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "@types/semver": "^7.8.0",
    "@ocean/ocean-package-manifest": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-host-plugin-inventory": "workspace:*",
    "@ocean/ocean-subprocess": "workspace:*",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-tool-executor-native": "workspace:*",
    "@ocean/ocean-tool-testkit": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-hmr": "workspace:*",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@ocean/ocean-brand": "workspace:*",
    "@ocean/ocean-sandbox-policy": "workspace:*",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-sandbox": "workspace:*",
    "@ocean/ocean-user-approval": "workspace:*",
    "@ocean/ocean-client-connection": "workspace:*",
    "@types/hosted-git-info": "^3.0.5"
  }
}
