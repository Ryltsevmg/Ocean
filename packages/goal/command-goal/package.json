{
  "name": "@ocean/ocean-command-goal",
  "description": "Human-facing slash command for persisted same-session goals",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/goal/command-goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ocean/ocean-commands": "workspace:*",
    "@ocean/ocean-goal": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-agent-loop": "workspace:*",
    "@ocean/ocean-agent-loop-testkit": "workspace:*",
    "@ocean/ocean-commands": "workspace:*",
    "@ocean/ocean-goal": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-session-projection": "workspace:*"
  }
}
