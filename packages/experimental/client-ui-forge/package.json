{
  "name": "@ocean/ocean-experimental-client-ui-forge",
  "description": "Sidebar panel for a Session's change requests, with a worktree option for new Sessions and its Host Remote",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/experimental/client-ui-forge"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@ocean/ocean-api-remotes",
        "@ocean/ocean-client-locale",
        "@ocean/ocean-client-ui-conversation",
        "@ocean/ocean-client-ui-layout",
        "@ocean/ocean-client-ui-plugin-manager",
        "@ocean/ocean-client-ui-settings",
        "@ocean/ocean-client-ui-sidebar-right",
        "@ocean/ocean-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-experimental-worktree": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-timeout": "workspace:*",
    "@ocean/ocean-experimental-forge": "workspace:*",
    "@ocean/ocean-fs": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "@ocean/ocean-util-values": "workspace:*",
    "diff": "^9.0.0",
    "zod": "4.6.6",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-storage-domain": "workspace:*",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-agent-loop-testkit": "workspace:*",
    "@ocean/ocean-api-remotes": "workspace:*",
    "@ocean/ocean-api-session-controller": "workspace:*",
    "@ocean/ocean-client-locale": "workspace:*",
    "@ocean/ocean-client-store": "workspace:*",
    "@ocean/ocean-client-test-runtime": "workspace:*",
    "@ocean/ocean-client-ui-conversation": "workspace:*",
    "@ocean/ocean-client-ui-layout": "workspace:*",
    "@ocean/ocean-client-ui-plugin-manager": "workspace:*",
    "@ocean/ocean-client-ui-primitives": "workspace:*",
    "@ocean/ocean-client-ui-renderer": "workspace:*",
    "@ocean/ocean-client-ui-session": "workspace:*",
    "@ocean/ocean-client-ui-settings": "workspace:*",
    "@ocean/ocean-client-ui-sidebar-right": "workspace:*",
    "@ocean/ocean-client-ui-slots": "workspace:*",
    "@ocean/ocean-client-ui-workspace": "workspace:*",
    "@ocean/ocean-experimental-forge": "workspace:*",
    "@ocean/ocean-experimental-forge-session": "workspace:*",
    "@ocean/ocean-experimental-worktree": "workspace:*",
    "@ocean/ocean-fs": "workspace:*",
    "@ocean/ocean-fs-local": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-sandbox": "workspace:*",
    "@ocean/ocean-sandbox-local": "workspace:*",
    "@ocean/ocean-sandbox-policy": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-subprocess": "workspace:*",
    "@ocean/ocean-subprocess-local": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-util-workspace-path": "workspace:*",
    "@ocean/ocean-working-directory": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@ocean/ocean-timeout": "workspace:*",
    "@ocean/ocean-session-projection-cache": "workspace:*",
    "@ocean/ocean-session-query": "workspace:*",
    "@ocean/ocean-api-remote-access": "workspace:*",
    "@types/picomatch": "^4.0.3"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ]
}
