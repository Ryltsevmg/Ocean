{
  "name": "@ocean/ocean-experimental-browser-use-stagehand-native",
  "description": "Experimental Stagehand browser tools with separately configured native models",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/experimental/browser-use-stagehand-native"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-browser-use": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-tools": "workspace:*"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.4.0",
    "@ocean/ocean-experimental-browser-use-runtime": "workspace:*",
    "@ocean/ocean-mcp-client": "workspace:*",
    "@ocean/ocean-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.6.6",
    "@ocean/ocean-subprocess": "workspace:*",
    "@puppeteer/browsers": "3.2.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-agent-loop": "workspace:*",
    "@ocean/ocean-agent-loop-testkit": "workspace:*",
    "@ocean/ocean-attachment": "workspace:*",
    "@ocean/ocean-attachment-local": "workspace:*",
    "@ocean/ocean-browser-use": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-tool-executor-native": "workspace:*",
    "@ocean/ocean-tool-testkit": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "tsx": "^4.23.13"
  }
}
