{
  "name": "@ocean/ocean-plugin-recommendations",
  "description": "Official plugin suggestions with explicit user activation and persistent conversation decisions",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/experimental/plugin-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./skills/*.md": "./skills/*.md"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-skill": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-plugin-manager": "workspace:*",
    "@ocean/ocean-package-manifest": "workspace:*",
    "@ocean/ocean-api-remote-access": "workspace:*",
    "@ocean/ocean-skill": "workspace:*"
  },
  "dependencies": {
    "zod": "4.6.6",
    "@ocean/ocean-client-ui-plugin-recommendations": "workspace:*",
    "@ocean/ocean-action-cards": "workspace:*",
    "@ocean/ocean-client-ui-action-cards": "workspace:*"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "skills/*.md",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "icon": "./icon.svg"
}
