{
  "name": "@ocean/ocean-action-cards",
  "description": "Optional action cards below answers: one shared proposal tool, card state, user actions and status notices",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/experimental/action-cards"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-session": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-typert-protocol": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-agent-loop": "workspace:*",
    "@ocean/ocean-agent-loop-testkit": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-api-remote-access": "workspace:*",
    "@ocean/ocean-sandbox-policy": "workspace:*",
    "@ocean/ocean-skill": "workspace:*",
    "@ocean/ocean-tool-skill": "workspace:*",
    "@ocean/ocean-tool-testkit": "workspace:*",
    "@ocean/ocean-util-values": "workspace:*"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ]
}
