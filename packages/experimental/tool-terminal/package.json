{
  "name": "@ocean/ocean-tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/experimental/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-terminal": "workspace:*",
    "@ocean/ocean-output-retention": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-jobs": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-agent-loop-testkit": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-terminal": "workspace:*",
    "@ocean/ocean-terminal-bash": "workspace:*",
    "@ocean/ocean-output-retention": "workspace:*",
    "@ocean/ocean-sandbox": "workspace:*",
    "@ocean/ocean-sandbox-policy": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-subprocess-local": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-jobs": "workspace:*",
    "@ocean/ocean-jobs-local": "workspace:*",
    "@ocean/ocean-tool-executor-native": "workspace:*",
    "@ocean/ocean-tool-executor-ptc": "workspace:*",
    "@ocean/ocean-tool-jobs": "workspace:*",
    "@ocean/ocean-tool-testkit": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-working-directory": "workspace:*"
  }
}
