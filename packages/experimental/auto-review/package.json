{
  "name": "@ocean/ocean-experimental-auto-review",
  "description": "Per-tool LLM authorization review for the Ocean Auto permission preset",
  "version": "0.2.2-rc.2",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-agent-instructions": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-permission-presets": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-working-directory": "workspace:*"
  },
  "dependencies": {
    "@ocean/ocean-util-values": "workspace:*"
  },
  "devDependencies": {
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-agent-instructions": "workspace:*",
    "@ocean/ocean-agent-loop": "workspace:*",
    "@ocean/ocean-agent-loop-testkit": "workspace:*",
    "@ocean/ocean-bash-sandbox": "workspace:*",
    "@ocean/ocean-compaction": "workspace:*",
    "@ocean/ocean-fs-local": "workspace:*",
    "@ocean/ocean-fs-observation-policy": "workspace:*",
    "@ocean/ocean-fs-sandbox": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-llm-deepseek": "workspace:*",
    "@ocean/ocean-llm-deepseek-api-key": "workspace:*",
    "@ocean/ocean-permission-presets": "workspace:*",
    "@ocean/ocean-ptc-runtime-node": "workspace:*",
    "@ocean/ocean-sandbox": "workspace:*",
    "@ocean/ocean-sandbox-policy": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-shell": "workspace:*",
    "@ocean/ocean-shell-env": "workspace:*",
    "@ocean/ocean-subagent": "workspace:*",
    "@ocean/ocean-subprocess-local": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-tool-bash": "workspace:*",
    "@ocean/ocean-tool-executor-native": "workspace:*",
    "@ocean/ocean-tool-executor-ptc": "workspace:*",
    "@ocean/ocean-tool-fs": "workspace:*",
    "@ocean/ocean-tool-subagent": "workspace:*",
    "@ocean/ocean-tool-testkit": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-user-approval": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
