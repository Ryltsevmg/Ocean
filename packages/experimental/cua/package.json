{
  "name": "@ocean/ocean-cua",
  "description": "Shared Computer Use application objects, authorization, and logged tool execution",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/experimental/cua"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api.d.ts",
      "default": "./lib/api.js"
    },
    "./bridge": {
      "types": "./lib/types/bridge.d.ts",
      "default": "./lib/bridge.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/remote-types.d.ts",
      "default": "./lib/remote-types.js"
    },
    "./native-client": {
      "types": "./lib/types/native-client.d.ts",
      "default": "./lib/native-client.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./config": {
      "types": "./lib/types/config.d.ts",
      "default": "./lib/config.js"
    },
    "./native-schema": {
      "types": "./lib/types/native-schema.d.ts",
      "default": "./lib/native-schema.js"
    },
    "./native-build": {
      "types": "./lib/types/native-build.d.ts",
      "default": "./lib/native-build.js"
    },
    "./guidance": {
      "types": "./lib/types/guidance.d.ts",
      "default": "./lib/guidance.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/remote-types.js",
    "lib/api.js",
    "lib/bridge.js",
    "lib/native-client.js",
    "lib/protocol.js",
    "lib/config.js",
    "lib/native-schema.js",
    "lib/native-build.js",
    "lib/guidance.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-error": "workspace:*",
    "@ocean/ocean-user-questions": "workspace:*",
    "@ocean/ocean-attachment": "workspace:*",
    "@ocean/ocean-scope": "workspace:*",
    "@ocean/ocean-ptc-runtime-node": "workspace:*",
    "@ocean/ocean-tool-executor-ptc": "workspace:*"
  },
