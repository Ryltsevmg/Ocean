{
  "name": "@ocean/ocean-browser-use-browse",
  "description": "Optional session-owned control of an explicitly paired browse browser",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/experimental/browser-use-browse"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./setup": {
      "types": "./lib/types/setup.d.ts",
      "default": "./lib/setup.js"
    },
    "./types": {
      "types": "./lib/types/remote-types.d.ts",
      "default": "./lib/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "lib/client.js",
    "lib/setup.js",
    "lib/types.js",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "@ocean/ocean-browser-use": "workspace:*",
    "@ocean/ocean-experimental-browser-use-runtime": "workspace:*",
    "@ocean/ocean-mcp-client": "workspace:*",
    "zod": "4.6.6",
    "@ocean/ocean-typert-protocol": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-browser-use": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-browser-use": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-agent-loop-testkit": "workspace:*",
    "@ocean/ocean-agent-loop": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-tool-executor-native": "workspace:*",
    "@ocean/ocean-tool-testkit": "workspace:*",
    "@ocean/ocean-fs-local": "workspace:*",
    "@ocean/ocean-working-directory": "workspace:*",
    "js-yaml": "^4.2.0",
    "@ocean/ocean-official-bundles": "workspace:*",
    "@ocean/ocean-api-remotes": "workspace:*",
    "@ocean/ocean-client-locale": "workspace:*",
    "@ocean/ocean-client-ui-plugin-manager": "workspace:*",
    "@ocean/ocean-client-ui-settings": "workspace:*",
    "@ocean/ocean-client-ui-layout": "workspace:*",
    "@ocean/ocean-config-editor": "workspace:*",
    "@ocean/ocean-client-store": "workspace:*",
    "@ocean/ocean-client-ui-primitives": "workspace:*",
    "@ocean/ocean-client-ui-slots": "workspace:*",
    "@ocean/ocean-client-ui-renderer": "workspace:*",
    "react": "^18.2.0",
    "@testing-library/react": "^16.1.0",
    "@ocean/ocean-client-test-runtime": "workspace:*",
    "react-dom": "^18.2.0"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin",
        "linux"
      ]
    },
    "client": {
      "inject": [
        "@ocean/ocean-api-remotes",
        "@ocean/ocean-client-locale",
        "@ocean/ocean-client-ui-plugin-manager",
        "@ocean/ocean-client-ui-settings",
        "@ocean/ocean-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
