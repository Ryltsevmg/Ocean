{
  "name": "@ocean/ocean-webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed Ocean Sessions",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/experimental/webhook"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-agent-default-model": "workspace:*",
    "@ocean/ocean-agent-preset-registry": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-permission-presets": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-title": "workspace:*",
    "@ocean/ocean-workspace": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-agent-default-model": "workspace:*",
    "@ocean/ocean-agent-preset-registry": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-permission-presets": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-title": "workspace:*",
    "@ocean/ocean-workspace": "workspace:*"
  },
  "dependencies": {
    "@ocean/ocean-brand": "workspace:*",
    "@ocean/ocean-util-values": "workspace:*"
  }
}
