{
  "name": "@ocean/ocean-mcp-manager",
  "description": "MCP server manager: a settings-driven fleet of mcp-client instances with runtime status, restart, and probe",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/mcp/mcp-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@ocean/ocean-mcp-client": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-util-values": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-typert-protocol": "workspace:*"
  },
  "dependencies": {
    "@ocean/ocean-timeout": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@ocean/ocean-credentials": "workspace:*",
    "@ocean/ocean-mcp-client": "workspace:*",
    "@ocean/ocean-settings": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-util-values": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-app-boot": "workspace:*",
    "@ocean/ocean-config-editor": "workspace:*",
    "@ocean/ocean-hmr": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@ocean/ocean-typert-protocol": "workspace:*"
  }
}
