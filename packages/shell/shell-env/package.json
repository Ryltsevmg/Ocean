{
  "name": "@ocean/ocean-shell-env",
  "description": "Tool-independent managed DSH_* shell environment registry",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/shell/shell-env"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-app-boot": "workspace:*",
    "@ocean/ocean-home-paths": "workspace:*",
    "@ocean/ocean-shell": "workspace:*",
    "@ocean/ocean-tools": "workspace:*",
    "@ocean/ocean-error": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-app-boot": "workspace:*",
    "@ocean/ocean-home-paths": "workspace:*",
    "@ocean/ocean-error": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-shell": "workspace:*",
    "@ocean/ocean-tools": "workspace:*"
  }
}
