{
  "name": "@ocean/ocean-host-directory-picker-auto",
  "description": "Adaptive chooser of the directory-picker seam: resolves the host situation at boot and mounts the native or browse backend for the Ocean web GUI host",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/host/directory-picker-auto"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-client-connection": "workspace:*",
    "@ocean/ocean-client-ui-directory-picker-browse": "workspace:*",
    "@ocean/ocean-client-ui-directory-picker-native": "workspace:*",
    "@ocean/ocean-host-directory-picker-browse": "workspace:*",
    "@ocean/ocean-host-directory-picker-native": "workspace:*",
    "@ocean/ocean-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-client-connection": "workspace:*",
    "@ocean/ocean-client-ui-directory-picker-browse": "workspace:*",
    "@ocean/ocean-client-ui-directory-picker-native": "workspace:*",
    "@ocean/ocean-host-directory-picker": "workspace:*",
    "@ocean/ocean-host-directory-picker-browse": "workspace:*",
    "@ocean/ocean-host-directory-picker-native": "workspace:*",
    "@ocean/ocean-host-webserver": "workspace:*"
  },
  "dependencies": {
    "@ocean/ocean-launch-environment": "workspace:*"
  }
}
