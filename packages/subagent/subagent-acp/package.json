{
  "name": "@ocean/ocean-subagent-acp",
  "description": "Out-of-process ACP subagent backend: drives a child agent in a spawned subprocess over the Agent Client Protocol",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/subagent/subagent-acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-subagent": "workspace:*",
    "@ocean/ocean-subprocess": "workspace:*",
    "@ocean/ocean-timeout": "workspace:*"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@ocean/ocean-brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-app-boot": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-loader-smoke": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-checkpoint-policy": "workspace:*",
    "@ocean/ocean-session-persistence-jsonl": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-subagent": "workspace:*",
    "@ocean/ocean-subprocess": "workspace:*",
    "@ocean/ocean-subprocess-local": "workspace:*",
    "@ocean/ocean-timeout": "workspace:*",
    "@ocean/ocean-tool-subagent": "workspace:*"
  }
}
