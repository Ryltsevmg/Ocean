{
  "name": "@ocean/ocean-subagent-dsh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Ocean runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/subagent/subagent-dsh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-sdk-client": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-subagent": "workspace:*",
    "@ocean/ocean-subprocess": "workspace:*"
  },
  "dependencies": {
    "@ocean/ocean-brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-agent-instructions": "workspace:*",
    "@ocean/ocean-app-boot": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-llm-deepseek": "workspace:*",
    "@ocean/ocean-llm-deepseek-api-key": "workspace:*",
    "@ocean/ocean-loader-smoke": "workspace:*",
    "@ocean/ocean-sdk-client": "workspace:*",
    "@ocean/ocean-sdk-protocol": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-checkpoint-policy": "workspace:*",
    "@ocean/ocean-session-persistence-jsonl": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-skill-filesystem": "workspace:*",
    "@ocean/ocean-subagent": "workspace:*",
    "@ocean/ocean-subprocess": "workspace:*",
    "@ocean/ocean-system-prompt": "workspace:*",
    "@ocean/ocean-tool-subagent": "workspace:*"
  }
}
