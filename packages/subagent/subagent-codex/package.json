{
  "name": "@ocean/ocean-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.2.2-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryltsevmg/Ocean.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-subagent": "workspace:*",
    "@ocean/ocean-subprocess": "workspace:*",
    "@ocean/ocean-timeout": "workspace:*"
  },
  "dependencies": {
    "@ocean/ocean-brand": "workspace:*",
    "@ocean/ocean-sdk-protocol": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@openai/codex": "0.153.4",
    "@ocean/ocean-tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@ocean/ocean-agent": "workspace:*",
    "@ocean/ocean-app-boot": "workspace:*",
    "@ocean/ocean-llm": "workspace:*",
    "@ocean/ocean-loader-smoke": "workspace:*",
    "@ocean/ocean-session": "workspace:*",
    "@ocean/ocean-session-checkpoint-policy": "workspace:*",
    "@ocean/ocean-session-persistence-jsonl": "workspace:*",
    "@ocean/ocean-session-projection": "workspace:*",
    "@ocean/ocean-subagent": "workspace:*",
    "@ocean/ocean-subprocess": "workspace:*",
    "@ocean/ocean-subprocess-local": "workspace:*",
    "@ocean/ocean-timeout": "workspace:*",
    "@ocean/ocean-tool-jobs": "workspace:*",
    "@ocean/ocean-tools": "workspace:*"
  },
  "icon": "./icon.svg"
}
