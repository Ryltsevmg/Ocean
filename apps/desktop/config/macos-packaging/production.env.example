# Copy to production.env and configure the production service before selecting this preset.
OCEAN_DESKTOP_APP_ID=com.deepseek.ocean
OCEAN_DESKTOP_AUTO_UPDATE_ENV=production
OCEAN_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
OCEAN_DESKTOP_MACOS_PACK_CONCURRENCY=4
OCEAN_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
OCEAN_DESKTOP_MACOS_DOWNLOAD_PROXY=
OCEAN_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# OCEAN_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
