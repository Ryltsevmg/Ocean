# Copy to production.env in the same machine configuration directory and fill in the values.
OCEAN_DESKTOP_APP_ID=com.deepseek.ocean
OCEAN_DESKTOP_AUTO_UPDATE_ENV=production
OCEAN_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
OCEAN_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# OCEAN_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
OCEAN_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
OCEAN_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
