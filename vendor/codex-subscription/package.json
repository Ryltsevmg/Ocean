{
  "name": "@ocean/ocean-codex-subscription",
  "version": "0.2.2-rc.2",
  "description": "Ocean Codex subscription integration, adapted from WSL043/dsh-codex-subscription",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/*.js",
    "native/linux-voice-helper.py",
    "locale/*.json",
    "docs/plugin/*.md",
    "cordis.patch.yml",
    "README*.md",
    "DIRECTORY.md",
    "compatibility.json",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM-README.md",
    "README.md",
    "icon.svg",
    "OCEAN-SECURITY-REVIEW.md",
    "OCEAN-VERIFICATION.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@ocean/ocean-api-remotes",
        "@ocean/ocean-client-connection",
        "@ocean/ocean-client-locale",
        "@ocean/ocean-client-ui-conversation",
        "@ocean/ocean-client-ui-model-selection",
        "@ocean/ocean-client-ui-settings",
        "@ocean/ocean-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ocean": "node --test tests/auth-security.test.mjs tests/account-vault.test.mjs tests/account-status-controller.test.mjs tests/account-usage.test.mjs tests/subscription-transport.test.mjs tests/ocean-ui.test.mjs tests/ocean-policy.test.mjs tests/settings-adapter.test.mjs tests/host-settings-schema.test.mjs tests/transport-contract.test.mjs tests/oauth-network.test.mjs tests/subscription-settings-entry.test.mjs tests/client-chunks.test.mjs tests/ocean-package-version.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "openai-codex",
    "chatgpt-oauth",
